               strValue =
                   CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(857); // System
               return true;
-            case USER:
+            case CPVRChannelGroup::Origin::USER:
               strValue =
                   CServiceBroker::GetResourcesComponent().GetLocalizeStrings().Get(858); // User
               return true;
