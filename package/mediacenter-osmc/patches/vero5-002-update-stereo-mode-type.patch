From 7d9d82d7f4d63a2b5d5fa60f22d9c8f5f38b7c87 Mon Sep 17 00:00:00 2001
From: Soren Bjerg Andersen <sba@ifad.dk>
Date: Thu, 28 May 2026 08:20:00 +0200
Subject: [PATCH] Vero 5: update stereo mode type for Kodi 22

---
 xbmc/utils/AMLUtils.cpp                            | 10 +++++-----
 xbmc/utils/AMLUtils.h                              |  5 +++--
 xbmc/windowing/amlogic/WinSystemAmlogic.cpp        |  4 ++--
 xbmc/windowing/amlogic/WinSystemAmlogic.h          |  2 +-
 xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.cpp |  4 ++--
 xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.h   |  2 +-
 6 files changed, 14 insertions(+), 13 deletions(-)

diff --git a/xbmc/utils/AMLUtils.cpp b/xbmc/utils/AMLUtils.cpp
--- a/xbmc/utils/AMLUtils.cpp
+++ b/xbmc/utils/AMLUtils.cpp
@@ -1 +1 @@
-bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, const int stereo_mode)
+bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, RenderStereoMode stereo_mode)
@@ -1 +1 @@
-void aml_handle_display_stereo_mode(const int stereo_mode)
+void aml_handle_display_stereo_mode(RenderStereoMode stereo_mode)
@@ -1 +1 @@
-    case RENDER_STEREO_MODE_SPLIT_VERTICAL:
+    case RenderStereoMode::SPLIT_VERTICAL:
@@ -1 +1 @@
-    case RENDER_STEREO_MODE_SPLIT_HORIZONTAL:
+    case RenderStereoMode::SPLIT_HORIZONTAL:
@@ -1 +1 @@
-    case RENDER_STEREO_MODE_HARDWAREBASED:
+    case RenderStereoMode::HARDWAREBASED:
diff --git a/xbmc/utils/AMLUtils.h b/xbmc/utils/AMLUtils.h
--- a/xbmc/utils/AMLUtils.h
+++ b/xbmc/utils/AMLUtils.h
@@ -1,2 +1,3 @@
 #pragma once
 
+#include "rendering/RenderSystemTypes.h"
@@ -1 +1 @@
-bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, const int stereo_mode);
+bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, RenderStereoMode stereo_mode);
@@ -1 +1 @@
-void aml_handle_display_stereo_mode(const int stereo_mode);
+void aml_handle_display_stereo_mode(RenderStereoMode stereo_mode);
diff --git a/xbmc/windowing/amlogic/WinSystemAmlogic.cpp b/xbmc/windowing/amlogic/WinSystemAmlogic.cpp
--- a/xbmc/windowing/amlogic/WinSystemAmlogic.cpp
+++ b/xbmc/windowing/amlogic/WinSystemAmlogic.cpp
@@ -1 +1 @@
-  m_stereo_mode = RENDER_STEREO_MODE_OFF;
+  m_stereo_mode = RenderStereoMode::OFF;
@@ -1 +1 @@
-  RENDER_STEREO_MODE stereo_mode = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode();
+  RenderStereoMode stereo_mode = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode();
diff --git a/xbmc/windowing/amlogic/WinSystemAmlogic.h b/xbmc/windowing/amlogic/WinSystemAmlogic.h
--- a/xbmc/windowing/amlogic/WinSystemAmlogic.h
+++ b/xbmc/windowing/amlogic/WinSystemAmlogic.h
@@ -1 +1 @@
-  RENDER_STEREO_MODE m_stereo_mode;
+  RenderStereoMode m_stereo_mode;
diff --git a/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.cpp b/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.cpp
--- a/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.cpp
+++ b/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.cpp
@@ -1 +1 @@
-bool CWinSystemAmlogicGLESContext::SupportsStereo(RENDER_STEREO_MODE mode) const
+bool CWinSystemAmlogicGLESContext::SupportsStereo(RenderStereoMode mode) const
@@ -1 +1 @@
-  if (mode == RENDER_STEREO_MODE_HARDWAREBASED) {
+  if (mode == RenderStereoMode::HARDWAREBASED) {
diff --git a/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.h b/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.h
--- a/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.h
+++ b/xbmc/windowing/amlogic/WinSystemAmlogicGLESContext.h
@@ -1 +1 @@
-  bool SupportsStereo(RENDER_STEREO_MODE mode) const override;
+  bool SupportsStereo(RenderStereoMode mode) const override;
-- 
