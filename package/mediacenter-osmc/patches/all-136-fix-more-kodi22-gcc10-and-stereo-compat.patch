From 2f2b0d51a4c2de91897f81ec1d3fb8d686960e5b Mon Sep 17 00:00:00 2001
From: Soren Bjerg Andersen <sba@ifad.dk>
Date: Thu, 28 May 2026 07:45:00 +0200
Subject: [PATCH] Fix more Kodi 22 GCC 10 compatibility

---
 xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h | 17 ++++++++---------
 xbmc/filesystem/IFile.h                       |  4 +++-
 2 files changed, 11 insertions(+), 10 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
@@ -70,22 +70,21 @@ private:
     using namespace std::literals::string_view_literals;
     switch (type)
     {
-      using enum StreamType;
-      case NONE:
+      case StreamType::NONE:
         return "none"sv;
-      case AUDIO:
+      case StreamType::AUDIO:
         return "audio"sv;
-      case VIDEO:
+      case StreamType::VIDEO:
         return "video"sv;
-      case DATA:
+      case StreamType::DATA:
         return "data"sv;
-      case SUBTITLE:
+      case StreamType::SUBTITLE:
         return "subtitle"sv;
-      case TELETEXT:
+      case StreamType::TELETEXT:
         return "teletext"sv;
-      case RADIO_RDS:
+      case StreamType::RADIO_RDS:
         return "radio rds"sv;
-      case AUDIO_ID3:
+      case StreamType::AUDIO_ID3:
         return "audio id3"sv;
     }
     throw std::invalid_argument("no streamtype string found");
diff --git a/xbmc/filesystem/IFile.h b/xbmc/filesystem/IFile.h
--- a/xbmc/filesystem/IFile.h
+++ b/xbmc/filesystem/IFile.h
@@ -102,7 +102,9 @@ public:
       TRUNCATED, ///< The line is longer than the supplied buffer. The next read continues reading of the line
       OK, ///< Read a line
     };
-    using enum ResultCode;
+    static constexpr ResultCode FAILURE = ResultCode::FAILURE;
+    static constexpr ResultCode TRUNCATED = ResultCode::TRUNCATED;
+    static constexpr ResultCode OK = ResultCode::OK;
 
     ResultCode code; ///< The result of the read operation
     std::size_t length; ///< length of the read string without null terminator
-- 
2.34.1
