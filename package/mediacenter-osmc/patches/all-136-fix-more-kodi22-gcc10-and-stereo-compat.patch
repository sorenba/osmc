@@ -2,7 +2,7 @@
 
   std::unique_ptr<CVideoSync> GetVideoSync(CVideoReferenceClock *clock) override;
 
-  bool SupportsStereo(RENDER_STEREO_MODE mode) const override;
+  bool SupportsStereo(RenderStereoMode mode) const override;
 };
 
