From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OSMC <osmc@osmc.tv>
Date: Fri, 29 May 2026 15:45:00 +0200
Subject: [PATCH] Fix more GCC 10 and stereo compatibility

Qualify more enum values for GCC 10, and update a downstream stereo mode
type reference to Kodi 22's RenderStereoMode name.
---
 xbmc/TextureDatabase.cpp                         | 25 ++++++++++++-----------
 xbmc/addons/ShaderPreset.cpp                     | 20 ++++++++----------
 xbmc/application/Application.cpp                 |  7 +++----
 xbmc/application/ApplicationPlay.cpp             | 12 +++++------
 xbmc/application/ApplicationPlayerCallback.cpp   |  4 ++--
 5 files changed, 33 insertions(+), 35 deletions(-)

diff --git a/xbmc/TextureDatabase.cpp b/xbmc/TextureDatabase.cpp
--- a/xbmc/TextureDatabase.cpp
+++ b/xbmc/TextureDatabase.cpp
@@ -17,7 +17,5 @@
 #include "utils/Variant.h"
 #include "utils/log.h"
 
-using enum CDatabaseQueryRule::FieldType;
-
 enum TextureField
 {
   TF_None = 0,
@@ -43,15 +41,15 @@ typedef struct
 
 // clang-format off
 static const translateField fields[] = {
-  { "none",          TF_None,          TEXT_FIELD },
-  { "textureid",     TF_Id,            REAL_FIELD },
-  { "url",           TF_Url,           TEXT_FIELD },
-  { "cachedurl",     TF_CachedUrl,     TEXT_FIELD },
-  { "lasthashcheck", TF_LastHashCheck, TEXT_FIELD },
-  { "imagehash",     TF_ImageHash,     TEXT_FIELD },
-  { "width",         TF_Width,         REAL_FIELD },
-  { "height",        TF_Height,        REAL_FIELD },
-  { "usecount",      TF_UseCount,      REAL_FIELD },
-  { "lastused",      TF_LastUsed,      TEXT_FIELD }
+  { "none",          TF_None,          CDatabaseQueryRule::FieldType::TEXT_FIELD },
+  { "textureid",     TF_Id,            CDatabaseQueryRule::FieldType::REAL_FIELD },
+  { "url",           TF_Url,           CDatabaseQueryRule::FieldType::TEXT_FIELD },
+  { "cachedurl",     TF_CachedUrl,     CDatabaseQueryRule::FieldType::TEXT_FIELD },
+  { "lasthashcheck", TF_LastHashCheck, CDatabaseQueryRule::FieldType::TEXT_FIELD },
+  { "imagehash",     TF_ImageHash,     CDatabaseQueryRule::FieldType::TEXT_FIELD },
+  { "width",         TF_Width,         CDatabaseQueryRule::FieldType::REAL_FIELD },
+  { "height",        TF_Height,        CDatabaseQueryRule::FieldType::REAL_FIELD },
+  { "usecount",      TF_UseCount,      CDatabaseQueryRule::FieldType::REAL_FIELD },
+  { "lastused",      TF_LastUsed,      CDatabaseQueryRule::FieldType::TEXT_FIELD }
 };
 // clang-format on
@@ -90,7 +88,7 @@ CDatabaseQueryRule::FieldType CTextureRule::GetFieldType(int field) const
 {
   for (const translateField& f : fields)
     if (field == f.field) return f.type;
-  return TEXT_FIELD;
+  return CDatabaseQueryRule::FieldType::TEXT_FIELD;
 }
 
 std::string CTextureRule::FormatParameter(const std::string &operatorString,
