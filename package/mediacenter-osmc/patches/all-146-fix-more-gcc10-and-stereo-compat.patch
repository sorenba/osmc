@@ -281,13 +279,12 @@ SHADER::ScaleType CShaderPresetAddon::TranslateScaleType(SHADER_SCALE_TYPE type
 {
   switch (type)
   {
-    using enum KODI::SHADER::ScaleType;
     case SHADER_SCALE_TYPE_INPUT:
