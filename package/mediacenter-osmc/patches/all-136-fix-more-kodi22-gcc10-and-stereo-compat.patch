From 2f2b0d51a4c2de91897f81ec1d3fb8d686960e5b Mon Sep 17 00:00:00 2001
From: Soren Bjerg Andersen <sba@ifad.dk>
Date: Thu, 28 May 2026 07:45:00 +0200
Subject: [PATCH] Fix more Kodi 22 GCC 10 and stereo mode compatibility

---
 8 files changed

diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVDDemux.h
@@ -4,22 +4,21 @@
     using namespace std::literals::string_view_literals;
     switch (type)
     {
-      using enum StreamType;
-      case NONE:
+      case StreamType::NONE:
         return "none"sv;
-      case AUDIO:
+      case StreamType::AUDIO:
         return "audio"sv;
-      case VIDEO:
+      case StreamType::VIDEO:
         return "video"sv;
-      case DATA:
+      case StreamType::DATA:
         return "data"sv;
-      case SUBTITLE:
+      case StreamType::SUBTITLE:
         return "subtitle"sv;
-      case TELETEXT:
+      case StreamType::TELETEXT:
         return "teletext"sv;
-      case RADIO_RDS:
+      case StreamType::RADIO_RDS:
         return "radio rds"sv;
-      case AUDIO_ID3:
+      case StreamType::AUDIO_ID3:
         return "audio id3"sv;
     }
     throw std::invalid_argument("no streamtype string found");
diff --git a/xbmc/filesystem/IFile.h b/xbmc/filesystem/IFile.h
--- a/xbmc/filesystem/IFile.h
+++ b/xbmc/filesystem/IFile.h
@@ -7,7 +7,9 @@
       TRUNCATED, ///< The line is longer than the supplied buffer. The next read continues reading of the line
       OK, ///< Read a line
     };
-    using enum ResultCode;
+    static constexpr ResultCode FAILURE = ResultCode::FAILURE;
+    static constexpr ResultCode TRUNCATED = ResultCode::TRUNCATED;
+    static constexpr ResultCode OK = ResultCode::OK;
 
     ResultCode code; ///< The result of the read operation
     std::size_t length; ///< length of the read string without null terminator
diff --git a/xbmc/utils/AMLUtils.cpp b/xbmc/utils/AMLUtils.cpp
--- a/xbmc/utils/AMLUtils.cpp
+++ b/xbmc/utils/AMLUtils.cpp
@@ -3,7 +3,7 @@
     SysfsUtils::SetString("/sys/class/amhdmitx/amhdmitx0/phy", enable ? "1" : "0");
 }
 
-bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, const int stereo_mode)
+bool aml_set_native_resolution(const RESOLUTION_INFO &res, std::string framebuffer_name, RenderStereoMode stereo_mode)
 {
   bool result = false;
 
@@ -23,20 +23,20 @@
     aml_disable_freeScale();
 }
 
-void aml_handle_display_stereo_mode(const int stereo_mode)
+void aml_handle_display_stereo_mode(RenderStereoMode stereo_mode)
 {
   static std::string lastHdmiTxConfig = "3doff";
 
   std::string command = "3doff";
   switch (stereo_mode)
   {
-    case RENDER_STEREO_MODE_SPLIT_VERTICAL:
+    case RenderStereoMode::SPLIT_VERTICAL:
       command = "3dlr";
       break;
-    case RENDER_STEREO_MODE_SPLIT_HORIZONTAL:
+    case RenderStereoMode::SPLIT_HORIZONTAL:
       command = "3dtb";
       break;
-    case RENDER_STEREO_MODE_HARDWAREBASED:
+    case RenderStereoMode::HARDWAREBASED:
       command = "3dfp";
       break;
     default:
diff --git a/xbmc/utils/AMLUtils.h b/xbmc/utils/AMLUtils.h
--- a/xbmc/utils/AMLUtils.h
+++ b/xbmc/utils/AMLUtils.h
