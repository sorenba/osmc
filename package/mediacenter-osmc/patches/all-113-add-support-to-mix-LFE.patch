From 8571d5d41ab778706afb24c0270e6803ef186b95 Mon Sep 17 00:00:00 2001
From: Sam Nazarko <email@samnazarko.co.uk>
Date: Tue, 28 Feb 2023 21:03:39 +0000
Subject: [PATCH] Support mixing LFE channel

Signed-off-by: Sam Nazarko <email@samnazarko.co.uk>
---
 system/settings/settings.xml | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/system/settings/settings.xml b/system/settings/settings.xml
--- a/system/settings/settings.xml
+++ b/system/settings/settings.xml
@@ -3315,17 +3315,17 @@
           <default>true</default>
           <control type="toggle" />
         </setting>
-        <setting id="audiooutput.mixsublevel" type="integer" label="34114" help="34115">
+        <setting id="audiooutput.mixsublevel" type="integer" label="36457" help="36458">
           <level>2</level>
           <default>0</default>
           <constraints>
-            <options>
-              <option label="34116">0</option>
-              <option label="34117">50</option>
-              <option label="34118">100</option>
-            </options>
+            <minimum>0</minimum>
+            <step>10</step>
+            <maximum>100</maximum>
           </constraints>
-          <control type="list" format="string" />
+          <control type="spinner" format="string">
+            <formatlabel>36459</formatlabel>
+          </control>
         </setting>
       </group>
       <group id="2" label="15108">
-- 
2.34.1

