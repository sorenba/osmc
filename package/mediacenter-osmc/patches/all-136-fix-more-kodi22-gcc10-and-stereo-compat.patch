+++ b/xbmc/windowing/amlogic/WinSystemAmlogic.cpp
@@ -3,7 +3,7 @@
   m_displayWidth = 0;
   m_displayHeight = 0;
 
-  m_stereo_mode = RENDER_STEREO_MODE_OFF;
+  m_stereo_mode = RenderStereoMode::OFF;
   m_delayDispReset = false;
 
   aml_permissions();
@@ -12,7 +12,7 @@
 bool CWinSystemAmlogic::CreateNewWindow(const std::string &name, bool fullScreen, RESOLUTION_INFO &res)
 {
   RESOLUTION_INFO current_resolution;
-  RENDER_STEREO_MODE stereo_mode = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode();
+  RenderStereoMode stereo_mode = CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoMode();
   bool dvOutput = IsDolbyVisionOutput();
 
   if (m_bWindowCreated && aml_get_native_resolution(&current_resolution)
